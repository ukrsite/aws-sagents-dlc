# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required
AWS_REGION=us-east-1

# Required when not using an IAM role (EC2/ECS picks up credentials automatically)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Optional — only needed for temporary session credentials
# AWS_SESSION_TOKEN=your_session_token

# Optional — override the default Bedrock model
# MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# MODEL_ID=us.amazon.nova-pro-v1:0

# Optional — set to 1 to print tool call logs to stdout (default: off, logs go to outputs/agent_trace.jsonl)
# AIDLC_VERBOSE=1

# Optional — set to 1 to skip the npx MCP filesystem server (CLI only; uses write_aidlc_artifact / scan_directory instead)
# AIDLC_DISABLE_MCP=1

# Optional — max output tokens per Bedrock model turn (default 8192; raise only if your model supports it)
# AIDLC_MAX_OUTPUT_TOKENS=8192

# Optional — S3 session persistence (for deployed AgentCore only; disable for local dev)
# Default: true (enabled) for deployed AgentCore Runtime (Lambda)
# Set to false for local development with `agentcore dev`
USE_S3_PERSISTENCE=false

# Optional — S3 bucket name for session storage (only used when USE_S3_PERSISTENCE=true)
# SESSION_BUCKET=aidlc-agentcore-sessions
